<Project>
  <!-- MSBuild imports only the nearest Directory.Build.props automatically. -->
  <Import Project="../Directory.Build.props" />

  <!-- The nine projects named below target net10.0 only, and this condition is load-bearing, not
       decorative. A non-empty inherited TargetFrameworks makes the SDK run its cross-targeting outer
       build over every listed framework by global property, and a project's own <TargetFramework>
       does not override that. Removing this condition restores TargetFrameworks for these nine, which
       restores the outer build, which restores EF Core and Npgsql against net8.0 and net9.0 alongside
       net10.0 and fails with NU1202, since those packages only support net10.0 (measured, ROADMAP 0.3
       Phase 15 Task 7). A new net10.0-only project must therefore both be added to this condition's
       exclusion list and declare its own <TargetFramework>; declaring the framework alone is not
       enough. The earlier claim (ROADMAP 0.3 Phase 14 addendum decision 31) that a project's own
       TargetFramework "wins" over this inherited TargetFrameworks measured only the condition-active
       state, where TargetFrameworks was never actually set for these nine projects, so nothing was
       ever contending with TargetFramework for precedence; that claim is amended by the Phase 15
       addendum. -->
  <PropertyGroup>
    <TargetFrameworks Condition="'$(MSBuildProjectName)' != 'Statesman.Analyzers' and '$(MSBuildProjectName)' != 'Statesman.Persistence.EntityFrameworkCore' and '$(MSBuildProjectName)' != 'Statesman.Outbox.EntityFrameworkCore' and '$(MSBuildProjectName)' != 'Statesman.Persistence.EntityFrameworkCore.Sqlite' and '$(MSBuildProjectName)' != 'Statesman.Persistence.EntityFrameworkCore.SqlServer' and '$(MSBuildProjectName)' != 'Statesman.Persistence.EntityFrameworkCore.PostgreSQL' and '$(MSBuildProjectName)' != 'Statesman.Outbox.EntityFrameworkCore.Sqlite' and '$(MSBuildProjectName)' != 'Statesman.Outbox.EntityFrameworkCore.SqlServer' and '$(MSBuildProjectName)' != 'Statesman.Outbox.EntityFrameworkCore.PostgreSQL'">net8.0;net9.0;net10.0</TargetFrameworks>
    <IsPackable>true</IsPackable>

    <!-- The public-API compatibility gate, ROADMAP 0.2's last unshipped bullet. Directory.Build.props
         already sets EnablePackageValidation, which validates a package against itself; a BASELINE is
         what makes it validate against what consumers already have. v0.3.0 published fifteen of these
         twenty-two packages, so fifteen have one and the other seven blank this property in their own
         csproj — which is also the right default for a package added later, because a new package
         inherits a baseline version it was never published at and would fail its first pack otherwise.
         When 0.4.0 ships, bump this once and delete the seven overrides.

         It must be set HERE rather than on the pack command line: the baseline nupkg is a
         restore-time download, so passing PackageValidationBaselineVersion via `-p:` on a
         `dotnet pack` that skips the build (the no-build flag) fails with MSB4018 /
         FileNotFoundException (measured). Both packing workflows run
         `dotnet restore Statesman.slnx` first, so both get the gate with no workflow edit.
         Deliberate breaks are recorded in each project's CompatibilitySuppressions.xml and explained
         in docs/reference/api-compatibility.md — never in an XML comment, which does not survive
         regeneration (measured). Addendum decisions 39 through 42. -->
    <PackageValidationBaselineVersion>0.3.0</PackageValidationBaselineVersion>
  </PropertyGroup>
</Project>
