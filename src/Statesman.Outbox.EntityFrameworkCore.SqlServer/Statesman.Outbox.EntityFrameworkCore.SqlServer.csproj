<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Not published in v0.3.0, so there is no baseline to validate against: this package's first
         published version will be its own baseline from 0.4.0 onward. Blanking the inherited
         src/Directory.Build.props value disables baseline validation for this project alone and
         leaves EnablePackageValidation's other checks in place (measured: all seven pack clean).
         Delete this once 0.4.0 has shipped. -->
    <PackageValidationBaselineVersion></PackageValidationBaselineVersion>
    <AssemblyName>Statesman.Outbox.EntityFrameworkCore.SqlServer</AssemblyName>
    <RootNamespace>Statesman.Outbox.EntityFrameworkCore.SqlServer</RootNamespace>
    <Description>SQL Server migrations for the Statesman Entity Framework Core outbox cursor context.</Description>
    <!-- Microsoft.EntityFrameworkCore.Design (PrivateAssets=all, design-time only) pins Microsoft.CodeAnalysis.Workspaces.Common exactly; the repo's central CSharp.Workspaces version conflicts with it under transitive pinning (NU1608). Scoped to this package; nothing here ships. -->
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
    <!-- Design's build props turn on GenerateRuntimeConfigurationFiles so dotnet ef can load this assembly; that stays on, but the resulting .runtimeconfig.json is inert to a consumer and is dropped from the packed lib folder by narrowing the pack extension default to exclude .json before NuGet.Build.Tasks.Pack.targets sets it from AllowedOutputExtensionsInPackageBuildOutputFolder, which only appends to this default rather than replacing it. Addendum decision 37. -->
    <DefaultAllowedOutputExtensionsInPackageBuildOutputFolder>.dll;.exe;.winmd;.pri;.xml</DefaultAllowedOutputExtensionsInPackageBuildOutputFolder>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Statesman.Outbox.EntityFrameworkCore/Statesman.Outbox.EntityFrameworkCore.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>
</Project>
