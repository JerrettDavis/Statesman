<Project>
  <!-- Directory.Build.props is imported before each project body, so IsPackable
       may not yet be set there. Add the package README after project evaluation. -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
